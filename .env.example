# ============================================================
# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit it.
# ============================================================

# ── LLM Providers ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_LLM_PROVIDER=gemini          # gemini | anthropic

# ── Scraping safety limits (do not exceed to avoid bans) ─────
MAX_DAILY_CONNECTIONS=15             # LinkedIn connection requests/day
MAX_DAILY_MESSAGES=20                # LinkedIn messages/day
SCRAPE_DELAY_MIN=3                   # seconds between actions (min)
SCRAPE_DELAY_MAX=8                   # seconds between actions (max)

# ── Job search parameters ─────────────────────────────────────
MIN_FIT_SCORE=0.65                   # 0.0–1.0, below this score = skip
SALARY_MIN_USD_MONTH=7000

# ── Paths (defaults work out of the box) ─────────────────────
# DB_PATH=data/jobs.db
# CV_JSON_PATH=data/master_cv.json
# PLAYWRIGHT_STATE_PATH=data/session_state.json
